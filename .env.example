# PostgreSQL
DB_NAME=festify
DB_USER=festify
DB_PASSWORD=change-me

# Base64-encoded key, at least 256 bits (generate one with: openssl rand -base64 32)
JWT_SECRET=change-me-with-a-base64-encoded-secret-key

# Port the app is exposed on
APP_PORT=8080

# Optional: admin account created on first startup
ADMIN_EMAIL=admin@festify.local
ADMIN_PASSWORD=change-me
